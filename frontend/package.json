{
  "name": "noto-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/copy-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure-bundle.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run typecheck && npm run check:boundaries && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "dompurify": "^3.1.5",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.0",
    "lucide-preact": "^1.61.0",
    "marked": "^12.0.2",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@testing-library/preact": "^3.2.4",
    "@types/dompurify": "^3.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  }
}
