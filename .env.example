# Noto — example environment file
#
# Copy to `.env` and adjust. The Go server reads these values from the
# process environment; it does NOT parse this file itself. Load it into the
# current shell (PowerShell example below) before starting the server.
#
# PowerShell:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object {
#     $name, $value = $_ -split '=', 2
#     [Environment]::SetEnvironmentVariable($name.Trim(), $value.Trim(), 'Process')
#   }
#
# Every variable is optional; the defaults shown are the built-in ones.

# --- Network -----------------------------------------------------------------

# TCP address the HTTP server listens on. Default: 127.0.0.1:8080
# A non-loopback address requires NOTO_ALLOW_PUBLIC=true, because Noto has
# no user accounts and no login of any kind.
# NOTO_ADDR=127.0.0.1:8080

# Set to true to allow the server to bind a non-loopback address. Default: false
# NOTO_ALLOW_PUBLIC=false

# Comma separated list of extra browser origins allowed to call the API,
# e.g. https://notes.example.com. Empty (default) means no CORS headers at
# all are sent. CORS is not authentication.
# NOTO_ALLOWED_ORIGINS=

# --- Storage -----------------------------------------------------------------

# Root of all persistent state. Default: <user config dir>/noto
# On Windows this is %AppData%\noto, on Linux ~/.config/noto,
# on macOS ~/Library/Application Support/noto.
#
# The variable only chooses the DEFAULT location of the data. It does not fix
# the storage: the user can still change the folder of the notes at runtime.
# NOTO_DATA_DIR=

# Directory holding the Markdown notes. Default: <NOTO_DATA_DIR>/notes
# Like NOTO_DATA_DIR, it only chooses the default location.
# NOTO_NOTES_DIR=

# Fix the storage of the notes: the folder cannot be changed at runtime and
# the application shows it as a normal state. Any value except an empty
# string, "0" and "false" enables the fix. The end-to-end tests use it.
# NOTO_VAULT_FIXED=

# Directory holding uploaded attachments. Default: <NOTO_DATA_DIR>/attachments
# NOTO_ATTACHMENTS_DIR=

# Directory holding deleted-but-restorable notes. Default: <NOTO_DATA_DIR>/trash
# NOTO_TRASH_DIR=

# SQLite database file. Default: <NOTO_DATA_DIR>/noto.db
# NOTO_DB_PATH=

# Directory with a built frontend to serve instead of the assets embedded in
# the binary. Empty (default) means the embedded assets are used.
# NOTO_STATIC_DIR=

# --- Limits ------------------------------------------------------------------

# Maximum size of a single upload body, in megabytes. Default: 32
# NOTO_MAX_UPLOAD_MB=32

# Maximum uncompressed size of an imported archive, in megabytes. Default: 256
# NOTO_MAX_ARCHIVE_MB=256

# Per-request timeout, in seconds. Default: 60
# NOTO_REQUEST_TIMEOUT_SEC=60

# Graceful shutdown timeout, in seconds. Default: 15
# NOTO_SHUTDOWN_TIMEOUT_SEC=15

# Log verbosity: debug, info, warn or error. Default: info
# NOTO_LOG_LEVEL=info
